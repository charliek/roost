<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Info.plist for the iced macOS app, in both of the identities
  `mac/scripts/bundle-iced.sh` assembles (ROOST_BUNDLE_IDENTITY):

    production  Roost.app — ai.stridelabs.Roost / Roost. The shipped
                app. Its id is the one the Swift Roost.app used, so it
                updates that app in place and resolves the same `Mac`
                profile paths (roost-ipc's BundleProfile).
    dev         Roost-Iced.app — ai.stridelabs.Roost.iced / Roost-Iced.
                Runs beside an installed Roost.app: the id, the Dock name
                and the process name all differ, so `pgrep -x Roost` never
                matches it.

  `bundle-lib.sh`'s roost_stamp_plist fills the three `@`-wrapped
  placeholders below — VERSION (the workspace version, see
  `roost_workspace_version`), BUNDLE_ID and APP_NAME — and fails on any
  placeholder it leaves behind.

  Sparkle: the template carries NO SUFeedURL and NO SUPublicEDKey.
  bundle-iced.sh inserts both from ROOST_BUNDLE_SPARKLE_FEED_URL +
  ROOST_BUNDLE_SPARKLE_ED_PUBLIC_KEY (both or neither; see
  roost_insert_sparkle_feed in bundle-lib.sh). A production build
  requires them; a dev build without them is feedless and never checks.
  SUEnableAutomaticChecks is present and false: with the updater
  instantiated, an ABSENT key would trigger Sparkle's first-run "check
  automatically?" permission prompt — the explicit false suppresses
  scheduled checks and that prompt; checks stay strictly user-invoked.

  Device-permission purpose strings (NSMicrophone/Camera/AppleEvents
  UsageDescription): paired with the capture entitlements in
  Roost-Iced.entitlements. macOS shows these when a program hosted in a
  tab requests the microphone/camera (the request is attributed to this
  app, the TCC responsible app). Both must be present — the entitlement
  to permit the request under the hardened runtime, the string for the
  prompt.
-->
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleIdentifier</key>
  <string>@BUNDLE_ID@</string>
  <key>CFBundleName</key>
  <string>@APP_NAME@</string>
  <key>CFBundleDisplayName</key>
  <string>@APP_NAME@</string>
  <key>CFBundleExecutable</key>
  <string>@APP_NAME@</string>
  <key>CFBundleIconFile</key>
  <string>AppIcon</string>
  <key>CFBundleIconName</key>
  <string>AppIcon</string>
  <key>CFBundleVersion</key>
  <string>@VERSION@</string>
  <key>CFBundleShortVersionString</key>
  <string>@VERSION@</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleSignature</key>
  <string>????</string>
  <key>LSMinimumSystemVersion</key>
  <string>15.0</string>
  <key>NSHighResolutionCapable</key>
  <true/>
  <key>NSPrincipalClass</key>
  <string>NSApplication</string>
  <key>NSSupportsAutomaticGraphicsSwitching</key>
  <true/>
  <key>LSUIElement</key>
  <false/>
  <key>SUEnableAutomaticChecks</key>
  <false/>
  <key>NSHumanReadableCopyright</key>
  <string>Copyright © 2026 Charlie Knudsen. MIT-licensed.</string>
  <key>NSMicrophoneUsageDescription</key>
  <string>A program running in @APP_NAME@ would like to use the microphone.</string>
  <key>NSCameraUsageDescription</key>
  <string>A program running in @APP_NAME@ would like to use the camera.</string>
  <key>NSAppleEventsUsageDescription</key>
  <string>A program running in @APP_NAME@ would like to use AppleScript.</string>
</dict>
</plist>
