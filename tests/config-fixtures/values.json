{
  "group": "config_values",
  "cases": [
    {
      "name": "plain-scalar-values",
      "content": "theme = Dracula\nfont-family = JetBrains Mono\nfont-size = 14\ncopy-on-select = clipboard\nclipboard-write = deny\nshow-sidebar-agents = false\nword-break-chars = _-\n",
      "expect": {
        "theme": "Dracula",
        "font_family": "JetBrains Mono",
        "font_size": 14,
        "copy_on_select": "clipboard",
        "clipboard_write": "deny",
        "show_sidebar_agents": false,
        "word_break_chars": "_-",
        "keybinds": [],
        "commands": [],
        "providers": []
      }
    },
    {
      "name": "double-quoted-theme",
      "content": "theme = \"Dracula\"\n",
      "expect": {
        "theme": "Dracula",
        "font_family": null,
        "font_size": null,
        "copy_on_select": "true",
        "clipboard_write": "allow",
        "show_sidebar_agents": true,
        "word_break_chars": null,
        "keybinds": [],
        "commands": [],
        "providers": []
      }
    },
    {
      "name": "single-quoted-theme",
      "content": "theme = 'Dracula'\n",
      "expect": {
        "theme": "Dracula",
        "font_family": null,
        "font_size": null,
        "copy_on_select": "true",
        "clipboard_write": "allow",
        "show_sidebar_agents": true,
        "word_break_chars": null,
        "keybinds": [],
        "commands": [],
        "providers": []
      }
    },
    {
      "name": "quoted-bool-and-enum-values",
      "content": "show-sidebar-agents = 'false'\ncopy-on-select = \"off\"\nclipboard-write = 'deny'\nfont-size = \"14\"\n",
      "expect": {
        "theme": null,
        "font_family": null,
        "font_size": 14,
        "copy_on_select": "off",
        "clipboard_write": "deny",
        "show_sidebar_agents": false,
        "word_break_chars": null,
        "keybinds": [],
        "commands": [],
        "providers": []
      }
    },
    {
      "name": "single-unmatched-leading-quote-kept",
      "content": "theme = \"dark\n",
      "expect": {
        "theme": "\"dark",
        "font_family": null,
        "font_size": null,
        "copy_on_select": "true",
        "clipboard_write": "allow",
        "show_sidebar_agents": true,
        "word_break_chars": null,
        "keybinds": [],
        "commands": [],
        "providers": []
      }
    },
    {
      "name": "mismatched-quote-pair-kept-verbatim",
      "content": "theme = \"dark'\n",
      "expect": {
        "theme": "\"dark'",
        "font_family": null,
        "font_size": null,
        "copy_on_select": "true",
        "clipboard_write": "allow",
        "show_sidebar_agents": true,
        "word_break_chars": null,
        "keybinds": [],
        "commands": [],
        "providers": []
      }
    },
    {
      "name": "nested-quotes-strip-one-pair-only",
      "content": "theme = \"\"Dracula\"\"\n",
      "expect": {
        "theme": "\"Dracula\"",
        "font_family": null,
        "font_size": null,
        "copy_on_select": "true",
        "clipboard_write": "allow",
        "show_sidebar_agents": true,
        "word_break_chars": null,
        "keybinds": [],
        "commands": [],
        "providers": []
      }
    },
    {
      "name": "empty-quoted-value-is-empty-string",
