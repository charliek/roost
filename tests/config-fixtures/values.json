    {
      "name": "command-full-field-coverage",
      "content": "command = label=\"Build All\" run=\"make all\" title=\"Building\" hold=true env=\"FOO=bar BAZ=qux\"\ncommand = label=ls run=ls\n",
      "expect": {
        "theme": null,
        "font_family": null,
        "font_size": null,
        "copy_on_select": "true",
        "clipboard_write": "allow",
        "show_sidebar_agents": true,
        "word_break_chars": null,
        "keybinds": [],
        "commands": [
          {
            "label": "Build All",
            "run": "make all",
            "title": "Building",
            "hold": true,
            "env": [["FOO", "bar"], ["BAZ", "qux"]]
          },
          {
            "label": "ls",
            "run": "ls",
            "title": "ls",
            "hold": false,
            "env": []
          }
        ],
        "providers": []
      }
    },
    {
      "name": "provider-full-field-coverage",
      "content": "provider = label=\"Open shed\" run=\"shed.sh --list\" title=\"Sheds\" timeout=8 limit=20\nprovider = label=Worktrees run=wt.sh\n",
      "expect": {
        "theme": null,
        "font_family": null,
        "font_size": null,
        "copy_on_select": "true",
        "clipboard_write": "allow",
        "show_sidebar_agents": true,
        "word_break_chars": null,
        "keybinds": [],
        "commands": [],
        "providers": [
          {
            "label": "Open shed",
            "run": "shed.sh --list",
            "title": "Sheds",
            "timeout_secs": 8,
            "limit": 20
          },
          {
            "label": "Worktrees",
            "run": "wt.sh",
            "title": "Worktrees",
            "timeout_secs": 5,
            "limit": 100
          }
        ]
      }
    },
    {
      "name": "comments-blanks-and-unknown-keys-dropped",
      "content": "# a comment\n\nfuture-key = zap\nnot a key value line\ntheme = Dracula\n",
      "expect": {
        "theme": "Dracula",
        "font_family": null,
        "font_size": null,
        "copy_on_select": "true",
        "clipboard_write": "allow",
        "show_sidebar_agents": true,
        "word_break_chars": null,
        "keybinds": [],
        "commands": [],
        "providers": []
      }
    }
  ]
}
