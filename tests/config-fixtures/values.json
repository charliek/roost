    {
      "name": "word-break-chars-quoted-leading-space",
      "content": "word-break-chars = \" -\"\n",
      "expect": {
        "theme": null,
        "font_family": null,
        "font_size": null,
        "copy_on_select": "true",
        "clipboard_write": "allow",
        "show_sidebar_agents": true,
        "word_break_chars": " -",
        "keybinds": [],
        "commands": [],
        "providers": []
      }
    },
    {
      "name": "quoted-trigger-keybind-kept-verbatim",
      "content": "keybind = \"ctrl+t\" = new_tab\n",
      "expect": {
        "theme": null,
        "font_family": null,
        "font_size": null,
        "copy_on_select": "true",
