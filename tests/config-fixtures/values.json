        "show_sidebar_agents": true,
        "word_break_chars": null,
        "keybinds": [{ "trigger": "\"ctrl+t\"", "action": "new_tab" }],
        "commands": [],
        "providers": []
      }
    },
    {
      "name": "keybind-action-containing-equals",
      "content": "keybind = ctrl+t = new_tab\nkeybind = ctrl+p = goto=next\n",
      "expect": {
        "theme": null,
        "font_family": null,
        "font_size": null,
        "copy_on_select": "true",
        "clipboard_write": "allow",
        "show_sidebar_agents": true,
        "word_break_chars": null,
        "keybinds": [
          { "trigger": "ctrl+t", "action": "new_tab" },
          { "trigger": "ctrl+p", "action": "goto=next" }
        ],
        "commands": [],
        "providers": []
      }
    },
    {
      "name": "duplicate-keys-last-wins",
      "content": "theme = first\ntheme = second\nfont-size = 12\nfont-size = 15\n",
      "expect": {
        "theme": "second",
        "font_family": null,
        "font_size": 15,
        "copy_on_select": "true",
        "clipboard_write": "allow",
        "show_sidebar_agents": true,
        "word_break_chars": null,
        "keybinds": [],
        "commands": [],
